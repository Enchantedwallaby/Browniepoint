# Brownie Point Operations System - Supabase Configuration
# Copy this file to .env.local and populate with your actual Supabase credentials.
# NEVER commit .env.local into version control.

VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# IMPORTANT: Never use the service_role / secret key here.
# Only the anon (publishable) key belongs in frontend environment variables.
